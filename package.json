{
  "name": "spectre-manifest-workspace",
  "private": true,
  "description": "Workspace for the Spectre manifest package and schema tooling.",
  "author": "PHCDevworks",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm --filter @phcdevworks/spectre-manifest build",
    "typecheck": "pnpm --filter @phcdevworks/spectre-manifest typecheck",
    "validate:manifest": "pnpm --filter @phcdevworks/spectre-manifest build && pnpm --filter @phcdevworks/spectre-manifest validate -- ../../spectre.manifest.json"
  }
}

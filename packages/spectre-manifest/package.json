{
  "name": "@phcdevworks/spectre-manifest",
  "version": "0.1.0",
  "description": "Machine-readable contract package for Spectre architecture, package boundaries, and tooling validation.",
  "keywords": [
    "phcdevworks",
    "spectre",
    "spectre-manifest",
    "architecture",
    "contract",
    "schema",
    "validation",
    "tooling"
  ],
  "author": "PHCDevworks",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "bin": {
    "spectre-manifest-validate": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema": "./schema/spectre.manifest.schema.json"
  },
  "files": [
    "dist",
    "schema",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phcdevworks/spectre-manifest.git"
  },
  "bugs": {
    "url": "https://github.com/phcdevworks/spectre-manifest/issues"
  },
  "homepage": "https://github.com/phcdevworks/spectre-manifest#readme",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test test/cli.test.mjs test/validator.test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "validate": "node dist/cli.js",
    "check": "npm run typecheck && npm run build && npm test"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1"
  },
  "devDependencies": {
    "@types/node": "^25.8.0",
    "typescript": "6.0.3"
  }
}

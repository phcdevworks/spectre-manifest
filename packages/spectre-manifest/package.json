{
  "name": "@phcdevworks/spectre-manifest",
  "version": "1.1.0",
  "description": "@phcdevworks/spectre-manifest is the manifest schema and contract tooling package of the Spectre system. It records package roles, layers, ownership boundaries, and dependency rules in one machine-readable source of truth, and validates each package's spectre.manifest.json against it.",
  "keywords": [
    "phcdevworks",
    "spectre",
    "spectre-manifest",
    "architecture",
    "contract",
    "schema",
    "validation",
    "tooling"
  ],
  "author": "PHCDevworks",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "bin": {
    "spectre-manifest-validate": "dist/cli.js",
    "spectre-manifest-check": "dist/check-cli.js",
    "spectre-manifest-diff": "dist/diff-cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema": "./schema/spectre.manifest.schema.json",
    "./manifest": "./spectre.manifest.json"
  },
  "files": [
    "dist",
    "schema",
    "spectre.manifest.json",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phcdevworks/spectre-manifest.git"
  },
  "bugs": {
    "url": "https://github.com/phcdevworks/spectre-manifest/issues"
  },
  "homepage": "https://github.com/phcdevworks/spectre-manifest#readme",
  "scripts": {
    "build": "tsc -p tsconfig.json && node --experimental-strip-types ../../scripts/copy-manifest.ts",
    "test": "node --test test/cli.test.mjs test/validator.test.mjs test/checker.test.mjs test/differ.test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "validate": "node dist/cli.js",
    "check": "npm run typecheck && npm run build && npm test"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "typescript": "7.0.2"
  }
}
